-- Hàm tạo Hitbox mới gắn vào quái
local function CreateGhostHitbox(model)
    if model:FindFirstChild("GhostHitbox") then return end
    
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
    if not root then return end

    local ghost = Instance.new("Part")
    ghost.Name = "GhostHitbox"
    ghost.Parent = model
    ghost.Shape = Enum.PartType.Block
    ghost.Color = Color3.fromRGB(255, 0, 0)
    ghost.Material = Enum.Material.Neon
    ghost.CanCollide = false
    ghost.CanTouch = true
    ghost.Anchored = true -- Khóa vị trí để mình tự điều khiển bằng script
    
    -- Vòng lặp dính khối này vào quái mỗi khung hình
    task.spawn(function()
        while model.Parent and _G.HitboxEnabled do
            if root then
                ghost.CFrame = root.CFrame
                ghost.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                ghost.Transparency = _G.Transparency
            else
                break
            end
            task.wait()
        end
        ghost:Destroy()
    end)
end

-- Vòng lặp quét quái liên tục
task.spawn(function()
    while task.wait(1) do
        if _G.HitboxEnabled then
            for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v.Name ~= game.Players.LocalPlayer.Name then
                    CreateGhostHitbox(v)
                    
                    -- Luôn bật Highlight để không bị mất dấu
                    if not v:FindFirstChild("HitboxHighlight") then
                        local hl = Instance.new("Highlight", v)
                        hl.Name = "HitboxHighlight"
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.FillAlpha = 0.5
                    end
                end
            end
        end
    end
end)
