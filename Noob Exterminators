local function makeesp()
    for _, noob in pairs(workspace.Bots:GetChildren()) do
        if noob:IsA("Model") then
            local hum = noob:FindFirstChild("Humanoid")
            if hum then
                local check = noob:FindFirstChild("Highlight")
                if check then check:Destroy() end
                local esp = Instance.new("Highlight")
                esp.Parent = noob
                if noob.Name == "Mini Noob" then
                    esp.FillColor = Color3.new(1, 1, 0)
                end
            end
        end
    end
end

Tab:CreateButton({
   Name = "noob ESP",
   Callback = function()
       makeesp()
   end,
