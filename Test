local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "The Ngoc Hub | Hitbox v6 Fixed",
   LoadingTitle = "Đang khóa mục tiêu...",
   LoadingSubtitle = "by The Ngoc",
   ConfigurationSaving = {Enabled = true, FolderName = "TheNgocHub", FileName = "ConfigV6"}
})

_G.HitboxSize = 20
_G.HitboxEnabled = false

local MainTab = Window:CreateTab("Chức Năng", 4483362458)

MainTab:CreateToggle({
   Name = "Kích Hoạt Hitbox Cố Định",
   CurrentValue = false,
   Flag = "HitboxToggle", 
   Callback = function(Value) _G.HitboxEnabled = Value end,
})

MainTab:CreateSlider({
   Name = "Kích Thước",
   Range = {1, 100},
   Increment = 1,
   CurrentValue = 20,
   Flag = "SizeSlider", 
   Callback = function(Value) _G.HitboxSize = Value end,
})

-- Logic Tạo Hitbox Phụ (Gắn chặt vào quái)
task.spawn(function()
    while task.wait(0.5) do
        if _G.HitboxEnabled then
            for _, model in pairs(game:GetService("Workspace"):GetDescendants()) do
                -- Chỉ lọc quái (Model có Humanoid)
                if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") and model.Name ~= game.Players.LocalPlayer.Name then
                    
                    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
                    
                    if root then
                        -- 1. Xử lý bộ phận gốc
                        root.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                        root.Transparency = 0.7
                        root.Color = Color3.fromRGB(255, 0, 0)
                        root.Material = Enum.Material.Neon
                        root.CanCollide = false
                        root.CanTouch = true
                        
                        -- 2. Chống rơi: Đảm bảo RootPart không bị tách rời khỏi Model
                        if root:IsA("Part") then
                            root.Anchored = false
                        end

                        -- 3. Tạo viền Highlight chuẩn
                        if not model:FindFirstChild("HitboxHighlight") then
                            local hl = Instance.new("Highlight", model)
                            hl.Name = "HitboxHighlight"
                            hl.FillColor = Color3.fromRGB(255, 0, 0)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillAlpha = 0.5
                        end
                    end
                end
            end
        end
    end
end)

Rayfield:Notify({
   Title = "Hoàn Tất!",
   Content = "Bản v6 đã sửa lỗi rơi Hitbox. Hãy bật Toggle để kiểm tra!",
   Duration = 5,
})
