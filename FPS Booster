-- Kiểm tra trùng lặp
if _G.SmartFPSBoosterExecuted then
    warn("FPS Booster đã chạy rồi!")
    return
end
_G.SmartFPSBoosterExecuted = true

local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local UserSettings = UserSettings()
local GameSettings = UserSettings.GameSettings

-- Danh sách bảo vệ (Không xóa các phần này)
local function isImportant(obj)
    if not obj:IsA("BasePart") then return false end
    local name = obj.Name:lower()
    local protectedNames = {"baseplate", "spawnlocation", "floor", "ground", "sàn", "checkpoint", "teleport"}
    
    for _, v in pairs(protectedNames) do
        if name:find(v) then return true end
    end
    
    -- Kiểm tra từ khóa chứa "floor" hoặc "plate"
    if name:find("floor") or name:find("plate") then return true end
    return false
end

-- Hàm tối ưu hóa vật thể
local function optimizePart(obj)
    -- Xử lý Part / MeshPart
    if obj:IsA("BasePart") then
        if not isImportant(obj) then
            obj.Material = Enum.Material.SmoothPlastic
            obj.CastShadow = false
            obj.Reflectance = 0
            
            if obj:IsA("MeshPart") then
                obj.TextureID = ""
            end
        end
    -- Xử lý Decal / Texture
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        if not isImportant(obj.Parent) then
            obj:Destroy()
        end
    -- Xử lý hiệu ứng dư thừa
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or 
           obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Beam") then
        obj:Destroy()
    end
end

-- 1. Quét map ban đầu (Dùng task.spawn để không làm treo game)
task.spawn(function()
    local descendants = Workspace:GetDescendants()
    for i, v in ipairs(descendants) do
        if i % 150 == 0 then RunService.Heartbeat:Wait() end
        optimizePart(v)
    end
end)

-- 2. Đón đầu các vật thể mới
Workspace.DescendantAdded:Connect(function(v)
    -- Bỏ qua nhân vật của người chơi
    if Players.LocalPlayer.Character and v:IsDescendantOf(Players.LocalPlayer.Character) then return end
    optimizePart(v)
end)

-- 3. Tối ưu hóa Lighting
Lighting.GlobalShadows = false
Lighting.Brightness = 1
Lighting.ClockTime = 12
Lighting.Ambient = Color3.fromRGB(200, 200, 200) -- Tăng độ sáng môi trường nhẹ
Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)

for _, v in pairs(Lighting:GetChildren()) do
    if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
        v:Destroy()
    end
end

-- 4. Giải phóng RAM định kỳ & Ép chất lượng đồ họa thấp nhất
task.spawn(function()
    while true do
        -- Ép mức đồ họa thấp nhất
        GameSettings.SavedQualityLevel = Enum.QualityLevel.Level01
        
        -- Dọn dẹp rác (Garbage Collection)
        collectgarbage("collect")
        
        task.wait(20)
    end
end)

print("Smart FPS Booster đã kích hoạt thành công!")
