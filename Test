local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "The Ngoc Hub | Monster Hitbox",
   LoadingTitle = "Đang khởi chạy hệ thống...",
   LoadingSubtitle = "by The Ngoc",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "TheNgocHub_Hitbox", 
      FileName = "Config"
   }
})

-- Khởi tạo biến môi trường
_G.HitboxSize = 10
_G.HitboxEnabled = false
_G.HitboxTransparency = 0.5

local MainTab = Window:CreateTab("Chức Năng", 4483362458)

-- Toggle Bật/Tắt
MainTab:CreateToggle({
   Name = "Kích hoạt Hitbox Quái",
   CurrentValue = false,
   Flag = "Toggle1", 
   Callback = function(Value)
      _G.HitboxEnabled = Value
   end,
})

-- Slider chỉnh kích thước
MainTab:CreateSlider({
   Name = "Kích thước (Studs)",
   Range = {1, 100},
   Increment = 1,
   Suffix = " Size",
   CurrentValue = 10,
   Flag = "Slider1", 
   Callback = function(Value)
      _G.HitboxSize = Value
   end,
})

-- Slider chỉnh độ trong suốt
MainTab:CreateSlider({
   Name = "Độ trong suốt",
   Range = {0, 1},
   Increment = 0.1,
   Suffix = "",
   CurrentValue = 0.5,
   Flag = "Slider2", 
   Callback = function(Value)
      _G.HitboxTransparency = Value
   end,
})

-- Vòng lặp xử lý logic chính
task.spawn(function()
    while task.wait(1) do
        if _G.HitboxEnabled then
            -- Quét toàn bộ Workspace để tìm đối tượng phù hợp
            for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                -- CHỈ LỌC: Model có Humanoid (Quái/NPC) và không phải là bạn
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Name ~= game.Players.LocalPlayer.Name then
                    local hrp = v:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        -- Áp dụng thay đổi cho HumanoidRootPart
                        hrp.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                        hrp.Transparency = _G.HitboxTransparency
                        hrp.Color = Color3.fromRGB(255, 0, 0) -- Màu đỏ
                        hrp.Material = Enum.Material.Neon
                        hrp.CanCollide = false
                        
                        -- Thêm hiệu ứng Highlight viền đỏ để dễ nhìn xuyên tường
                        local highlight = v:FindFirstChild("HitboxHighlight")
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "HitboxHighlight"
                            highlight.Parent = v
                        end
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.FillAlpha = _G.HitboxTransparency
                        highlight.Enabled = true
                    end
                end
            end
        else
            -- Reset về trạng thái cũ khi tắt Toggle
            for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                if v:IsA("Part") and v.Name == "HumanoidRootPart" then
                    v.Size = Vector3.new(2, 2, 1)
                    v.Transparency = 1
                    
                    local model = v.Parent
                    if model and model:FindFirstChild("HitboxHighlight") then
                        model.HitboxHighlight:Destroy()
                    end
                end
            end
        end
    end
end)

Rayfield:Notify({
   Title = "The Ngoc Hub",
   Content = "Script đã sẵn sàng!",
   Duration = 5,
   Image = 4483362458,
})
