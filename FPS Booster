local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local localPlayer = Players.LocalPlayer

-- 2. Bộ lọc bảo vệ Map (IsImportant)
local protectedNames = {
    ["Baseplate"] = true,
    ["SpawnLocation"] = true,
    ["Floor"] = true,
    ["Ground"] = true,
    ["Sàn"] = true,
    ["Checkpoint"] = true,
    ["Teleport"] = true
}

local function isImportant(instance)
    if not instance or not instance.Name then return false end
    
    -- Kiểm tra tên chính xác trong danh sách bảo vệ
    if protectedNames[instance.Name] then 
        return true 
    end
    
    -- Kiểm tra từ khóa chứa "floor" hoặc "plate"
    local lowerName = string.lower(instance.Name)
    if string.find(lowerName, "floor") or string.find(lowerName, "plate") then
        return true
    end
    
    return false
end

-- 3. Hàm Tối ưu hóa thông minh (SmartOptimize)
local function smartOptimize(v)
    if v:IsA("BasePart") then
        v.Material = Enum.Material.SmoothPlastic
        v.CastShadow = false
        v.Reflectance = 0
        
        -- Nếu là MeshPart và KHÔNG nằm trong danh sách bảo vệ thì xóa Texture
        if v:IsA("MeshPart") and not isImportant(v) then
            v.TextureID = ""
        end
        
    elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Trail") or v:IsA("Beam") then
        -- Xóa ngay lập tức các hiệu ứng hạt/chiêu thức gây lag
        v:Destroy()
        
    elseif v:IsA("Decal") or v:IsA("Texture") then
        -- Chỉ xóa Decal/Texture nếu vật thể cha không quan trọng
        if v.Parent and not isImportant(v.Parent) then
            v:Destroy()
        end
    end
end

-- 4. Quét Map ban đầu & Đón đầu hiệu ứng mới
-- Quét map ban đầu bằng task.spawn để không làm nghẽn luồng chính
task.spawn(function()
    local count = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        smartOptimize(v)
        count = count + 1
        
        -- Cứ mỗi 150 vật thể thì nghỉ một nhịp Heartbeat để chống khựng/đứng game
        if count % 150 == 0 then
            RunService.Heartbeat:Wait()
        end
    end
end)

-- Lắng nghe và xử lý các hiệu ứng chiêu thức mới xuất hiện
Workspace.DescendantAdded:Connect(function(v)
    -- Bỏ qua nếu vật thể thuộc về nhân vật của người chơi hiện tại
    if localPlayer.Character and v:IsDescendantOf(localPlayer.Character) then
        return
    end
    smartOptimize(v)
end)

-- 5. Tối ưu Ánh sáng (Lighting)
local function optimizeLighting()
    Lighting.GlobalShadows = false
    Lighting.Brightness = 1
    Lighting.ClockTime = 12 -- Cố định thời gian buổi trưa để map sáng rõ

    -- Xóa các hiệu ứng làm nhòe và đổ bóng nâng cao có sẵn
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
            v:Destroy()
        end
    end
end
optimizeLighting()

