local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "The Ngoc Hub | Hitbox v2",
   LoadingTitle = "Đang quét cấu trúc quái...",
   LoadingSubtitle = "by The Ngoc",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "TheNgocHub_Hitbox", 
      FileName = "ConfigV2"
   }
})

_G.HitboxSize = 10
_G.HitboxEnabled = false
_G.HitboxTransparency = 0.5

local MainTab = Window:CreateTab("Chức Năng", 4483362458)

MainTab:CreateToggle({
   Name = "Kích hoạt Hitbox Quái",
   CurrentValue = false,
   Flag = "HitboxToggle", 
   Callback = function(Value)
      _G.HitboxEnabled = Value
   end,
})

MainTab:CreateSlider({
   Name = "Kích thước",
   Range = {1, 100},
   Increment = 1,
   Suffix = " Size",
   CurrentValue = 10,
   Flag = "SizeSlider", 
   Callback = function(Value)
      _G.HitboxSize = Value
   end,
})

-- Vòng lặp xử lý quét diện rộng
task.spawn(function()
    while task.wait(0.5) do -- Tăng tốc độ quét lên 0.5s để nhận quái mới nhanh hơn
        if _G.HitboxEnabled then
            for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                -- Lọc các Model có Humanoid (đặc điểm của quái trong ảnh)
                if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v.Name ~= game.Players.LocalPlayer.Name then
                    
                    -- Tìm bộ phận chính (Ưu tiên HumanoidRootPart, nếu không có thì lấy Torso hoặc Head)
                    local targetPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("Head")
                    
                    if targetPart and targetPart:IsA("BasePart") then
                        targetPart.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                        targetPart.Transparency = _G.HitboxTransparency
                        targetPart.Color = Color3.fromRGB(255, 0, 0)
                        targetPart.Material = Enum.Material.Neon
                        targetPart.CanCollide = false
                        
                        -- Thêm viền Highlight để quái luôn rực rỡ
                        local highlight = v:FindFirstChild("HitboxHighlight")
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "HitboxHighlight"
                            highlight.Parent = v
                            highlight.FillColor = Color3.fromRGB(255, 0, 0)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        end
                        highlight.Enabled = true
                    end
                end
            end
        end
    end
end)

Rayfield:Notify({
   Title = "The Ngoc Hub",
   Content = "Nếu vẫn chưa hiện, hãy đảm bảo bạn đã bật Toggle!",
   Duration = 5,
   Image = 4483362458,
})
