-- ==========================================
-- FPS BOOSTER SMART RENDER (Delta Executor)
-- ==========================================

-- 1. Kiểm tra trùng lặp
if _G.SmartFPSBoosterExecuted then
    warn("[Smart FPS Booster]: Script đã được kích hoạt trước đó!")
    return
end
_G.SmartFPSBoosterExecuted = true

-- Khởi tạo các Services thiết yếu
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local localPlayer = Players.LocalPlayer

-- 2. Bộ lọc bảo vệ Map (IsImportant)
local protectedNames = {
    ["Baseplate"] = true,
    ["SpawnLocation"] = true,
    ["Floor"] = true,
    ["Ground"] = true,
    ["Sàn"] = true,
    ["Checkpoint"] = true,
    ["Teleport"] = true
}

local function isImportant(instance)
    if not instance or not instance.Name then return false end
    
    -- Kiểm tra tên chính xác trong danh sách bảo vệ
    if protectedNames[instance.Name] then 
        return true 
    end
    
    -- Kiểm tra từ khóa chứa "floor" hoặc "plate"
    local lowerName = string.lower(instance.Name)
    if string.find(lowerName, "floor") or string.find(lowerName, "plate") then
        return true
    end
    
    return false
end

-- 3. Hàm Tối ưu hóa thông minh (SmartOptimize)
local function smartOptimize(v)
    if v:IsA("BasePart") then
        v.Material = Enum.Material.SmoothPlastic
        v.CastShadow = false
        v.Reflectance = 0
        
        -- Nếu là MeshPart và KHÔNG nằm trong danh sách bảo vệ thì xóa Texture
        if v:IsA("MeshPart") and not isImportant(v) then
            v.TextureID = ""
        end
        
    elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Trail") or v:IsA("Beam") then
        -- Xóa ngay lập tức các hiệu ứng hạt/chiêu thức gây lag
        v:Destroy()
        
    elseif v:IsA("Decal") or v:IsA("Texture") then
        -- Chỉ xóa Decal/Texture nếu vật thể cha không quan trọng
        if v.Parent and not isImportant(v.Parent) then
            v:Destroy()
        end
    end
end

-- 4. Quét Map ban đầu & Đón đầu hiệu ứng mới
-- Quét map ban đầu bằng task.spawn để không làm nghẽn luồng chính
task.spawn(function()
    local count = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        smartOptimize(v)
        count = count + 1
        
        -- Cứ mỗi 150 vật thể thì nghỉ một nhịp Heartbeat để chống khựng/đứng game
        if count % 150 == 0 then
            RunService.Heartbeat:Wait()
        end
    end
end)

-- Lắng nghe và xử lý các hiệu ứng chiêu thức mới xuất hiện
Workspace.DescendantAdded:Connect(function(v)
    -- Bỏ qua nếu vật thể thuộc về nhân vật của người chơi hiện tại
    if localPlayer.Character and v:IsDescendantOf(localPlayer.Character) then
        return
    end
    smartOptimize(v)
end)

-- 5. Tối ưu Ánh sáng (Lighting)
local function optimizeLighting()
    Lighting.GlobalShadows = false
    Lighting.Brightness = 1
    Lighting.ClockTime = 12 -- Cố định thời gian buổi trưa để map sáng rõ

    -- Xóa các hiệu ứng làm nhòe và đổ bóng nâng cao có sẵn
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
            v:Destroy()
        end
    end
end
optimizeLighting()

-- Ngăn chặn các hiệu ứng Lighting mới được thêm vào sau đó
Lighting.ChildAdded:Connect(function(v)
    if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
        task.defer(function()
            v:Destroy()
        end)
    end
end)

-- 6. Cơ chế ẩn người chơi ở quá xa
task.spawn(function()
    while task.wait(3) do
        local myChar = localPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        if myRoot then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer and p.Character then
                    local pChar = p.Character
                    local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                    
                    if pRoot then
                        -- Tính khoảng cách Magnitude giữa 2 người chơi
                        local distance = (myRoot.Position - pRoot.Position).Magnitude
                        
                        if distance > 250 then
                            -- Quá 250 studs: Tạm thời đưa Parent về nil để ẩn render hoàn toàn
                            if pChar.Parent == Workspace then
                                pChar.Parent = nil
                            end
                        else
                            -- Dưới 250 studs: Đưa ngược về Workspace để hiển thị lại bình thường
                            if pChar.Parent == nil then
                                pChar.Parent = Workspace
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- 7. Giải phóng RAM định kỳ & Ép đồ họa tối thiểu
task.spawn(function()
    while task.wait(20) do
        gcinfo() -- Thu gom rác bộ nhớ (Garbage Collection) giải phóng RAM
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 -- Ép cấu hình đồ họa Roblox về mức thấp nhất
    end
end)

print("[Smart FPS Booster]: Kích hoạt thành công! Hiệu năng đã được tối ưu tối đa.")
