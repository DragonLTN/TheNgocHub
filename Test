local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "The Ngoc Hub | Hitbox v7",
   LoadingTitle = "Đang quét cấu trúc thực thể...",
   LoadingSubtitle = "by The Ngoc",
   ConfigurationSaving = {Enabled = true, FolderName = "TheNgocHub", FileName = "ConfigV7"}
})

_G.HitboxSize = 20
_G.HitboxEnabled = false

local MainTab = Window:CreateTab("Chức Năng", 4483362458)

MainTab:CreateToggle({
   Name = "Bật Hitbox Cố Định Quái",
   CurrentValue = false,
   Flag = "HitboxToggle", 
   Callback = function(Value) _G.HitboxEnabled = Value end,
})

MainTab:CreateSlider({
   Name = "Kích Thước",
   Range = {1, 100},
   Increment = 1,
   CurrentValue = 20,
   Flag = "SizeSlider", 
   Callback = function(Value) _G.HitboxSize = Value end,
})

-- Logic quét và ép dính Hitbox
task.spawn(function()
    while task.wait(0.3) do
        if _G.HitboxEnabled then
            -- Quét qua toàn bộ sinh vật có sự sống (Humanoid)
            for _, hum in pairs(game:GetService("Workspace"):GetDescendants()) do
                if hum:IsA("Humanoid") then
                    local ent = hum.Parent -- Thực thể (Quái/NPC)
                    
                    -- Loại bỏ bản thân người chơi
                    if ent and ent.Name ~= game.Players.LocalPlayer.Name then
                        
                        -- Tìm bộ phận làm tâm (Dùng bất cứ thứ gì có sẵn)
                        local core = ent:FindFirstChild("HumanoidRootPart") or ent:FindFirstChild("Torso") or ent:FindFirstChild("Head") or ent:FindFirstChildOfClass("Part") or ent:FindFirstChildOfClass("MeshPart")
                        
                        if core then
                            -- Ép kích thước và thuộc tính hiển thị
                            core.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                            core.Transparency = 0.7
                            core.Color = Color3.fromRGB(255, 0, 0)
                            core.Material = Enum.Material.Neon
                            
                            -- PHÁ KHÓA: Đảm bảo quái không bị rơi hitbox
                            core.CanCollide = false
                            core.CanTouch = true
                            core.Anchored = false
                            
                            -- Thêm Highlight để nhìn xuyên địa hình
                            if not ent:FindFirstChild("HitboxHighlight") then
                                local hl = Instance.new("Highlight", ent)
                                hl.Name = "HitboxHighlight"
                                hl.FillColor = Color3.fromRGB(255, 0, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.FillAlpha = 0.5
                            end
                        end
                    end
                end
            end
        end
    end
end)

Rayfield:Notify({
   Title = "The Ngoc Hub",
   Content = "Nếu quái vẫn chưa hiện khối đỏ, hãy thử kéo Slider lên mức 40!",
   Duration = 5,
})
