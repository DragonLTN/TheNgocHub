local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "The Ngoc Hub | Hitbox v3",
   LoadingTitle = "Đang tối ưu tầm đánh...",
   LoadingSubtitle = "by The Ngoc",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "TheNgocHub_Hitbox", 
      FileName = "ConfigV3"
   }
})

_G.HitboxSize = 20 -- Tăng mặc định lên 20 để dễ test
_G.HitboxEnabled = false

local MainTab = Window:CreateTab("Chức Năng", 4483362458)

MainTab:CreateToggle({
   Name = "Bật Hitbox (Đánh Xa)",
   CurrentValue = false,
   Flag = "HitboxToggle", 
   Callback = function(Value)
      _G.HitboxEnabled = Value
   end,
})

MainTab:CreateSlider({
   Name = "Tầm Đánh (Size)",
   Range = {1, 100},
   Increment = 1,
   Suffix = " Studs",
   CurrentValue = 20,
   Flag = "SizeSlider", 
   Callback = function(Value)
      _G.HitboxSize = Value
   end,
})

-- Vòng lặp xử lý ép kích thước (Force Size)
task.spawn(function()
    while task.wait(0.1) do -- Chạy cực nhanh để chống game reset hitbox
        if _G.HitboxEnabled then
            for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v.Name ~= game.Players.LocalPlayer.Name then
                    
                    -- Tìm tất cả các bộ phận có thể làm hitbox
                    local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("Head")
                    
                    if root then
                        -- ÉP KÍCH THƯỚC: Đây là phần giúp bạn đánh từ xa
                        root.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                        root.Transparency = 0.6 -- Để hơi mờ để bạn thấy đường đi
                        root.Color = Color3.fromRGB(255, 0, 0)
                        root.Material = Enum.Material.Neon
                        root.CanCollide = false -- Quan trọng: Để không bị đẩy văng khi quái lại gần
                        
                        -- Giữ viền Highlight cho quái
                        local highlight = v:FindFirstChild("HitboxHighlight")
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "HitboxHighlight"
                            highlight.Parent = v
                            highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        end
                        highlight.Enabled = true
                    end
                end
            end
        end
    end
end)

Rayfield:Notify({
   Title = "The Ngoc Hub",
   Content = "Hãy kéo Slider lên mức 20-30 để bắt đầu đánh xa!",
   Duration = 5,
})
