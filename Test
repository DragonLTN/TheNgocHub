local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "The Ngoc Hub | Hitbox Fix",
   LoadingTitle = "Đang cấu hình lại vật lý...",
   LoadingSubtitle = "by The Ngoc",
   ConfigurationSaving = {Enabled = true, FolderName = "TheNgocHub", FileName = "ConfigFix"}
})

_G.HitboxSize = 20
_G.HitboxEnabled = false

local MainTab = Window:CreateTab("Cài Đặt", 4483362458)

MainTab:CreateToggle({
   Name = "Kích Hoạt Hitbox",
   CurrentValue = false,
   Flag = "HitboxToggle", 
   Callback = function(Value) _G.HitboxEnabled = Value end,
})

MainTab:CreateSlider({
   Name = "Kích Thước",
   Range = {1, 100},
   Increment = 1,
   CurrentValue = 20,
   Flag = "SizeSlider", 
   Callback = function(Value) _G.HitboxSize = Value end,
})

-- Logic quét và ép dính mọi bộ phận
task.spawn(function()
    while task.wait(0.5) do
        if _G.HitboxEnabled then
            for _, model in pairs(game:GetService("Workspace"):GetDescendants()) do
                -- Lọc đúng sinh vật có thanh máu (Humanoid) và không phải là bạn
                if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") and model.Name ~= game.Players.LocalPlayer.Name then
                    
                    -- Duyệt tất cả bộ phận trong cơ thể quái
                    for _, part in pairs(model:GetChildren()) do
                        if part:IsA("BasePart") then
                            -- Ép kích thước vật lý
                            part.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                            part.Transparency = 0.8 -- Làm mờ để không che tầm nhìn
                            part.CanCollide = false
                            part.CanTouch = true
                            
                            -- Hiển thị khung dây đỏ (SelectionBox) để biết chính xác hitbox ở đâu
                            local sBox = part:FindFirstChild("MyHitbox")
                            if not sBox then
                                sBox = Instance.new("SelectionBox")
                                sBox.Name = "MyHitbox"
                                sBox.Parent = part
                                sBox.Adornee = part
                                sBox.Color3 = Color3.fromRGB(255, 0, 0)
                                sBox.LineThickness = 0.1
                            end
                            sBox.Visible = true
                        end
                    end
                end
            end
        end
    end
end)

Rayfield:Notify({
   Title = "Hoàn Tất",
   Content = "Hãy bật Toggle và tăng Size lên 30 để thấy khung đỏ bao quanh quái!",
   Duration = 5,
})
