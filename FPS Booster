_G.MaxRenderDistance = 1250

if _G.SmartFPSBoosterExecuted then return end
_G.SmartFPSBoosterExecuted = true

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local localPlayer = Players.LocalPlayer

local protectedNames = {
    ["Baseplate"] = true,
    ["SpawnLocation"] = true,
    ["Floor"] = true,
    ["Ground"] = true,
    ["Sàn"] = true,
    ["Checkpoint"] = true,
    ["Teleport"] = true
}

local function isImportant(instance)
    if not instance or not instance.Name then return false end
    if protectedNames[instance.Name] then 
        return true 
    end
    local lowerName = string.lower(instance.Name)
    if string.find(lowerName, "floor") or string.find(lowerName, "plate") then
        return true
    end
    return false
end

local function smartOptimize(v)
    if v:IsA("BasePart") then
        v.Material = Enum.Material.SmoothPlastic
        v.CastShadow = false
        v.Reflectance = 0
        if v:IsA("MeshPart") and not isImportant(v) then
            v.TextureID = ""
        end
    elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Clouds") then
        v:Destroy()
    elseif v:IsA("Decal") or v:IsA("Texture") then
        if v.Parent and not isImportant(v.Parent) then
            v:Destroy()
        end
    elseif v:IsA("Atmosphere") or v:IsA("Sky") then
        v:Destroy()
    end
end

task.spawn(function()
    local count = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        smartOptimize(v)
        count = count + 1
        if count % 150 == 0 then
            RunService.Heartbeat:Wait()
        end
    end
end)

Workspace.DescendantAdded:Connect(function(v)
    if localPlayer.Character and v:IsDescendantOf(localPlayer.Character) then
        return
    end
    smartOptimize(v)
end)

local function optimizeLighting()
    Lighting.GlobalShadows = false
    Lighting.Brightness = 1
    Lighting.ClockTime = 12
    
    Lighting.FogEnd = _G.MaxRenderDistance
    Lighting.FogStart = _G.MaxRenderDistance - 100
    
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
            v:Destroy()
        end
    end
end
optimizeLighting()

pcall(function()
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.Decoration = false
    end
    Workspace.GlobalWind = Vector3.new(0, 0, 0)
end)

Lighting.ChildAdded:Connect(function(v)
    if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
        task.defer(function()
            v:Destroy()
        end)
    end
end)

task.spawn(function()
    while task.wait(3) do
        local myChar = localPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer and p.Character then
                    local pChar = p.Character
                    local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                    if pRoot then
                        local distance = (myRoot.Position - pRoot.Position).Magnitude
                        if distance > _G.MaxRenderDistance then
                            if pChar.Parent == Workspace then
                                pChar.Parent = nil
                            end
                        else
                            if pChar.Parent == nil then
                                pChar.Parent = Workspace
                            end
                            
                            if not pChar:FindFirstChild("SmartRenderESP") then
                                local highlight = Instance.new("Highlight")
                                highlight.Name = "SmartRenderESP"
                                highlight.FillColor = Color3.fromRGB(255, 60, 60)
                                highlight.FillTransparency = 0.5
                                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                highlight.OutlineTransparency = 0
                                highlight.Parent = pChar
                            end
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(20) do
        gcinfo()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end
end)
